{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": { "contentSize": "1200px", "wideSize": "1440px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "red", "name": "Humann Red", "color": "#BC0F0F" },
				{ "slug": "red-deep", "name": "Deep Red", "color": "#AF0D0E" },
				{ "slug": "ink", "name": "Ink", "color": "#191C1C" },
				{ "slug": "charcoal", "name": "Charcoal", "color": "#414141" },
				{ "slug": "grey", "name": "Grey", "color": "#767676" },
				{ "slug": "silver", "name": "Silver", "color": "#A0A0A0" },
				{ "slug": "mist", "name": "Mist", "color": "#F5F5F5" },
				{ "slug": "cream", "name": "Cream", "color": "#F6F3ED" },
				{ "slug": "black", "name": "Black", "color": "#000000" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "serif",
					"name": "Serif (Moderat Serif substitute: Newsreader)",
					"fontFamily": "\"Moderat Serif\", Newsreader, Georgia, serif",
					"fontFace": [
						{ "fontFamily": "Newsreader", "fontStyle": "normal", "fontWeight": "400", "src": [ "file:./assets/fonts/Newsreader-normal.woff2" ] },
						{ "fontFamily": "Newsreader", "fontStyle": "italic", "fontWeight": "400", "src": [ "file:./assets/fonts/Newsreader-italic.woff2" ] }
					]
				},
				{
					"slug": "grotesk",
					"name": "Grotesk (Stabil Grotesk substitute: Inter Tight)",
					"fontFamily": "\"Stabil Grotesk\", \"Inter Tight\", \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{ "fontFamily": "Inter Tight", "fontStyle": "normal", "fontWeight": "400 700", "src": [ "file:./assets/fonts/InterTight-normal.woff2" ] }
					]
				},
				{
					"slug": "label",
					"name": "Label (Uniforma substitute: Archivo)",
					"fontFamily": "Uniforma, Archivo, \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{ "fontFamily": "Archivo", "fontStyle": "normal", "fontWeight": "400 600", "src": [ "file:./assets/fonts/Archivo-normal.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.125rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "2rem", "fluid": { "min": "1.5rem", "max": "2rem" } },
				{ "slug": "x-large", "name": "XL", "size": "3rem", "fluid": { "min": "2rem", "max": "3rem" } }
			]
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--white)", "text": "var(--wp--preset--color--charcoal)" },
		"spacing": { "blockGap": "0", "padding": { "left": "0", "right": "0" } },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--grotesk)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "500",
			"lineHeight": "1.35"
		},
		"elements": {
			"heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--serif)", "fontWeight": "400" } },
			"link": { "color": { "text": "currentColor" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Sticky section nav", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
