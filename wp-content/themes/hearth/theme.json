{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "720px", "wideSize": "1320px" },
		"color": {
			"defaultPalette": false,
			"palette": [
				{ "slug": "cream", "name": "Cream", "color": "#FAF9F4" },
				{ "slug": "linen", "name": "Linen", "color": "#EFEBE1" },
				{ "slug": "sand", "name": "Sand", "color": "#D9CFBC" },
				{ "slug": "taupe", "name": "Taupe", "color": "#8A7F6B" },
				{ "slug": "espresso", "name": "Espresso", "color": "#433B28" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.75rem" },
				{ "slug": "30", "name": "S", "size": "1.25rem" },
				{ "slug": "40", "name": "M", "size": "2rem" },
				{ "slug": "50", "name": "L", "size": "clamp(2.5rem, 5vw, 4rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(3.5rem, 8vw, 7rem)" }
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "serif",
					"name": "EB Garamond",
					"fontFamily": "\"EB Garamond\", Garamond, Georgia, serif",
					"fontFace": [
						{ "fontFamily": "EB Garamond", "fontStyle": "normal", "fontWeight": "400 600", "src": [ "file:./assets/fonts/EBGaramond-normal.woff2" ] },
						{ "fontFamily": "EB Garamond", "fontStyle": "italic", "fontWeight": "400", "src": [ "file:./assets/fonts/EBGaramond-italic.woff2" ] }
					]
				},
				{
					"slug": "sans",
					"name": "Hanken Grotesk",
					"fontFamily": "\"Hanken Grotesk\", \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{ "fontFamily": "Hanken Grotesk", "fontStyle": "normal", "fontWeight": "300 600", "src": [ "file:./assets/fonts/HankenGrotesk-normal.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.5rem", "fluid": { "min": "1.3rem", "max": "1.6rem" } },
				{ "slug": "x-large", "name": "XL", "size": "2.5rem", "fluid": { "min": "1.9rem", "max": "2.75rem" } },
				{ "slug": "xx-large", "name": "XXL", "size": "4rem", "fluid": { "min": "2.6rem", "max": "4.5rem" } }
			]
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--cream)", "text": "var(--wp--preset--color--espresso)" },
		"spacing": {
			"blockGap": "1.25rem",
			"padding": { "left": "clamp(1.25rem, 4vw, 3rem)", "right": "clamp(1.25rem, 4vw, 3rem)" }
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "300",
			"lineHeight": "1.7"
		},
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--serif)", "fontWeight": "400", "lineHeight": "1.15", "letterSpacing": "-0.005em" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"link": {
				"color": { "text": "currentColor" },
				"typography": { "textDecoration": "underline" },
				":hover": { "typography": { "textDecoration": "none" } }
			},
			"button": {
				"color": { "background": "var(--wp--preset--color--espresso)", "text": "var(--wp--preset--color--cream)" },
				"border": { "radius": "0" },
				"spacing": { "padding": { "top": "1rem", "bottom": "1rem", "left": "2rem", "right": "2rem" } },
				"typography": { "fontFamily": "var(--wp--preset--font-family--sans)", "fontSize": "0.78rem", "fontWeight": "500", "letterSpacing": "0.16em", "textTransform": "uppercase" },
				":hover": { "color": { "background": "var(--wp--preset--color--taupe)" } }
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": { "fontSize": "0.8rem", "textTransform": "uppercase", "fontWeight": "400" }
			},
			"core/post-title": { "elements": { "link": { "typography": { "textDecoration": "none" } } } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
